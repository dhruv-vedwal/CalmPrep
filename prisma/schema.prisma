generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  examType      String        @default("NEET")
  createdAt     DateTime      @default(now())
  moodEntries   MoodEntry[]
  chatMessages  ChatMessage[]
}

model MoodEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  mood        Int      // 1-5
  triggers    String   // JSON array stored as string
  journal     String   @default("")
  energy      Int      @default(5)
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}
